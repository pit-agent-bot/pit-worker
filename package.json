{
  "name": "@pit/cli",
  "private": true,
  "version": "0.1.0",
  "description": "Clean-room Pit seat daemon CLI (init / pair / doctor / start). Key never leaves this machine.",
  "type": "module",
  "bin": {
    "pit": "./bin/pit.js"
  },
  "scripts": {
